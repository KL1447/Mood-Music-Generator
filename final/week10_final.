import random

EMOTION = "happy"
CELL = "melody"

emotion = EMOTION.strip().lower()

if emotion == "happy":
    scale = [60, 62, 64, 65, 67, 69, 71, 72]
    beat_options = [0.5, 0.5, 0.25, 1]
    low_velocity = 80
    high_velocity = 110
    rest_chance = 5
    end_index = 0
    drum_step = 0.5
    hat_chance = 100
    bpm = 124
elif emotion == "calm":
    scale = [60, 62, 64, 67, 69, 72]
    beat_options = [1, 2, 1, 0.5]
    low_velocity = 50
    high_velocity = 70
    rest_chance = 20
    end_index = 0
    drum_step = 1
    hat_chance = 40
    bpm = 68
elif emotion == "nervous":
    scale = [60, 61, 63, 66, 67, 70, 72]
    beat_options = [0.25, 0.25, 0.5, 0.125]
    low_velocity = 55
    high_velocity = 120
    rest_chance = 30
    end_index = 1
    drum_step = 0.25
    hat_chance = 80
    bpm = 150
else:
    print("I don't know the feeling '" + EMOTION + "' - using calm.")
    emotion = "calm"
    scale = [60, 62, 64, 67, 69, 72]
    beat_options = [1, 2, 1, 0.5]
    low_velocity = 50
    high_velocity = 70
    rest_chance = 20
    end_index = 0
    drum_step = 1
    hat_chance = 40
    bpm = 68

total_beats = 8

print("Emotion: " + emotion + " | cell: " + CELL)
print("Set the TunePad project tempo to " + str(bpm) + " BPM")


def play_melody():
    beats_played = 0
    index = 0

    while beats_played < total_beats:
        beats = beat_options[random.randint(0, len(beat_options) - 1)]
        if beats_played + beats > total_beats:
            beats = total_beats - beats_played

        is_last = (beats_played + beats >= total_beats)

        if is_last:
            playNote(scale[end_index], beats=beats, velocity=high_velocity)
        elif beats_played > 0 and random.randint(1, 100) <= rest_chance:
            rest(beats)
        else:
            index = index + random.randint(-2, 2)
            if index < 0:
                index = 0
            if index > len(scale) - 1:
                index = len(scale) - 1

            velocity = random.randint(low_velocity, high_velocity)
            playNote(scale[index], beats=beats, velocity=velocity)

        beats_played = beats_played + beats


def play_drums():
    steps = int(total_beats / drum_step)
    for i in range(steps):
        if i % 2 == 0:
            playNote(0, beats=drum_step, velocity=100)
        elif random.randint(1, 100) <= hat_chance:
            playNote(5, beats=drum_step, velocity=60)
        else:
            rest(drum_step)


if CELL == "drums":
    play_drums()
else:
    play_melody()
