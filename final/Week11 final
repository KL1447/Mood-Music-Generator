def play_melody():
    beats_played = 0
    index = 0

    while beats_played < total_beats:
        beats = beat_options[random.randint(0, len(beat_options) - 1)]
        if beats_played + beats > total_beats:
            beats = total_beats - beats_played

        is_last = (beats_played + beats >= total_beats)

        if is_last:
            playNote(scale[end_index], beats=beats, velocity=high_velocity)
        elif beats_played > 0 and random.randint(1, 100) <= rest_chance:
            rest(beats)
        else:
            index = index + random.randint(-2, 2)
            if index < 0:
                index = 0
            if index > len(scale) - 1:
                index = len(scale) - 1

            velocity = random.randint(low_velocity, high_velocity)
            playNote(scale[index], beats=beats, velocity=velocity)

        beats_played = beats_played + beats


def play_drums():
    steps = int(total_beats / drum_step)
    for i in range(steps):
        if i % 2 == 0:
            if i == 0 or random.randint(1, 100) <= kick_chance:
                playNote(0, beats=drum_step, velocity=random.randint(85, 110))
            else:
                rest(drum_step)
        elif random.randint(1, 100) <= hat_chance:
            playNote(5, beats=drum_step, velocity=random.randint(45, 70))
        else:
            rest(drum_step)


def play_bass():
    steps = int(total_beats / bass_step)
    for i in range(steps):
        velocity = random.randint(70, 100)
        if i == steps - 1:
            playNote(bass_notes[end_index], beats=bass_step, velocity=velocity)
        elif i == 0:
            playNote(bass_notes[0], beats=bass_step, velocity=velocity)
        else:
            note = bass_notes[random.randint(0, len(bass_notes) - 1)]
            playNote(note, beats=bass_step, velocity=velocity)


def play_arp():
    steps = int(total_beats / arp_step)
